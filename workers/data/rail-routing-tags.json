{
  "_comment": [
    "Routing tag dictionary for tracks – archive `<region>-rail-routing.pmtiles`.",
    "The format of `routing-tags.json`, another dictionary and so another `id`:",
    "the rail network never joins the road one on the phone."
  ],
  "version": 1,
  "network": {
    "railway": [
      "rail",
      "light_rail",
      "subway",
      "tram",
      "narrow_gauge",
      "monorail",
      "funicular",
      "preserved"
    ]
  },
  "keys": {
    "railway": {
      "from_network": true,
      "what": "line kind"
    },
    "name": {
      "free": true,
      "what": "line name for the instruction"
    },
    "ref": {
      "free": true,
      "what": "line number"
    },
    "usage": {
      "values": [
        "main",
        "branch",
        "industrial",
        "military",
        "tourism",
        "scientific",
        "test"
      ],
      "what": "line significance"
    },
    "service": {
      "values": [
        "yard",
        "siding",
        "spur",
        "crossover"
      ],
      "what": "secondary track – dearer, not banned"
    },
    "maxspeed": {
      "free": true,
      "what": "line speed"
    },
    "gauge": {
      "free": true,
      "what": "gauge in mm"
    },
    "electrified": {
      "values": [
        "contact_line",
        "rail",
        "yes",
        "no",
        "4th_rail",
        "ground-level_power_supply"
      ],
      "what": "traction"
    },
    "oneway": {
      "values": [
        "yes",
        "no",
        "-1"
      ],
      "what": "one-way track"
    },
    "railway:preferred_direction": {
      "values": [
        "forward",
        "backward",
        "both"
      ],
      "what": "preferred direction"
    },
    "access": {
      "access": true,
      "what": "access"
    },
    "bridge": {
      "values": [
        "yes",
        "viaduct"
      ],
      "what": "bridge"
    },
    "tunnel": {
      "values": [
        "yes",
        "building_passage"
      ],
      "what": "tunnel"
    }
  },
  "_access": {
    "values": [
      "yes",
      "no",
      "private",
      "permissive",
      "unknown"
    ]
  }
}
